# Backend API Base URL
# Point this to your local Node.js server or production URL
VITE_API_BASE_URL=http://localhost:4000/api

# Mock Service Worker (MSW). Mocks are ON unless this is explicitly 'false'.
# Set to false to talk to the real backend at VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# Demo mode only. Never enable on a real deployment.
VITE_DEMO_MODE=false

# Shopper authentication via the real Node.js API in /server (login, sign-up, email OTP, password reset).
# Requires the API running at VITE_API_BASE_URL. Set to false to use the in-browser mock instead.
VITE_BUYER_AUTH_API=true
