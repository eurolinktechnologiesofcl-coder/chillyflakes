# ─────────────────────────────────────────────────────────────
# ChillyFlakes API — environment variables
# Copy to .env and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
#   Local dev (npm run db:dev): postgresql://postgres:postgres@localhost:5433/chillyflakes
#   VPS / FastPanel:            postgresql://USER:PASSWORD@127.0.0.1:5432/chillyflakes
#   Neon / Supabase:            paste the URL they give you (keep ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/chillyflakes

# Browser origins allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Public storefront URL (used in email links)
APP_URL=http://localhost:5173
APP_NAME=ChillyFlakes

SESSION_TTL_DAYS=30
# Set to true when running behind Nginx / FastPanel / a load balancer
TRUST_PROXY=false

# ─── Email (SMTP) ───────────────────────────────────────────
# Works with any provider — change these to switch to the client's mailbox later.
#
# Gmail:   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587 SMTP_SECURE=false  (587 is more reliable than 465 on many ISPs)
#          SMTP_USER=you@gmail.com    SMTP_PASS=<16-char App Password>
#          (Google Account → Security → 2-Step Verification → App passwords)
# Zoho:    smtp.zoho.in : 465 (secure)
# Hostinger: smtp.hostinger.com : 465 (secure)
# Brevo:   smtp-relay.brevo.com : 587
# Resend:  smtp.resend.com : 465, user "resend", pass = API key
#
# Leave SMTP_HOST empty in development to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ChillyFlakes <no-reply@yourdomain.com>"
SUPPORT_EMAIL=

# Development only: include one-time codes in API responses (ignored when NODE_ENV=production)
EXPOSE_DEV_CODES=true
